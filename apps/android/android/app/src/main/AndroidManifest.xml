<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- largeHeap: a forty-five minute song decoded for the speed control is
         hundreds of megabytes. Without it Android hands the app a small heap and
         the page is killed part-way through a lesson. -->
    <application
        android:allowBackup="true"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Keeping the song playing when the screen goes off. mediaPlayback is
             not optional from Android 14: a foreground service must say what
             kind it is, and an untyped one is refused at start. -->
        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- The pause button on a pair of headphones, and the buttons on the
             lock screen. Without this receiver the pending intents the
             notification carries have nothing to arrive at. -->
        <receiver android:name="androidx.media.session.MediaButtonReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Recording. Nothing else is asked for: songs reach the app through
         Android's own document picker, which needs no storage permission at all
         and is what lets a file in Drive or OneDrive be opened the same way as
         one on the phone. An app that asks for the whole of your storage to play
         one song is asking for far more than it needs. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- BOTH, OR NEITHER WORKS. When the page asks for a microphone, Capacitor
         asks Android for RECORD_AUDIO *and* MODIFY_AUDIO_SETTINGS together, and
         hands the page the microphone only if every one of them comes back
         granted. A permission that is not declared here is refused on the spot,
         so leaving this one out denied the microphone every single time — the
         app asked, Android said no to a permission nobody had heard of, and
         recording simply never worked. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Playing on with the screen off. The notification is not decoration: it
         is what makes the service a foreground one, which is what stops Android
         freezing the page. WAKE_LOCK keeps the processor awake, never the
         screen. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
</manifest>
