{
  "name": "tva-player",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ted's Voice Academy audio player and practice recorder for Windows",
  "workspaces": [
    "packages/*",
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm run dev -w @tva/desktop",
    "typecheck": "tsc -p packages/practice-core --noEmit",
    "test": "npm run test:harness && npm run test:harness:control && npm run test:no-native",
    "test:harness": "node scripts/player-harness.mjs",
    "test:harness:control": "node scripts/player-harness.mjs --negative-control",
    "test:app": "node scripts/app-harness.mjs",
    "test:app:control": "node scripts/app-harness.mjs --negative-control",
    "test:no-native": "node scripts/no-native-modules.mjs",
    "build": "npm run build -w @tva/desktop",
    "release": "npm run release -w @tva/desktop"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.25.0",
    "music-metadata": "^11.15.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
